# Database (SQLite for the minor project; switch to PostgreSQL for the major project)
DATABASE_URL=sqlite:///data/aisoc.db

# Comma-separated list of origins allowed to call the API from a browser.
# Add your Chrome extension origin here later: chrome-extension://<extension-id>
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# How long (hours) a scan result is reused for the same URL before re-scanning
SCAN_CACHE_HOURS=24
